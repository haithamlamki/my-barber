# Public — safe to ship to the browser
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser. Used by Server Actions, scheduled jobs, RLS-bypass admin paths.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase Postgres connection string (filled in after `supabase start`)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
# The single business this v0.1 deployment serves. Scopes the public /book catalog
# so a second tenant's services never surface here. Use the seeded demo business id.
NEXT_PUBLIC_BUSINESS_ID=10000000-0000-0000-0000-000000000001

# v0.2+ providers (left blank for v0.1 — fake adapters are used)
THAWANI_API_KEY=
THAWANI_PUBLISHABLE_KEY=
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
